    32	async def _to_thread_process_service(func: Callable[..., Any], /, *args: Any) -> Any:
    33	    """Offload blocking process-service work without inheriting request ContextVars."""
    34	    return await asyncio.to_thread(_run_in_fresh_context, func, *args)
