  1847	def derive_default_max_in_progress(sample: Optional[Mapping[str, Any]] = None) -> Optional[int]:
  1848	    """Memory-derived default for ``kanban.max_in_progress`` when unset:
  1849	    ``clamp(MemTotal / MEMORY_GUARD_MB_PER_WORKER, FLOOR, CEILING)``. Returns
  1850	    ``None`` (no cap) when total memory is unknown, so macOS/Windows dev
  1851	    machines are unaffected.
