  2791	def run_daemon(
  2792	    *,
  2793	    interval: float = 60.0,
  2794	    max_spawn: Optional[int] = None,
  2795	    failure_limit: int = DEFAULT_FAILURE_LIMIT,
  2796	    stop_event=None,
  2797	    on_tick=None,
  2798	) -> None:
  2799	    """Run the dispatcher in a loop until interrupted.
  2800	
  2801	    Calls :func:`dispatch_once` every ``interval`` seconds; exits cleanly on
  2802	    SIGINT / SIGTERM so it is systemd-friendly. ``stop_event`` and ``on_tick``
  2803	    are test hooks. Both this daemon and the gateway dispatcher re-resolve
  2804	    ``kanban.max_in_progress`` every tick: explicit config wins, otherwise
  2805	    they use the same memory-derived default as ``hermes kanban dispatch``.
  2806	    """
  2807	    import threading
  2808	
  2809	    if stop_event is None:
  2810	        stop_event = threading.Event()
  2811	
  2812	    def _handle(_signum, _frame):
  2813	        stop_event.set()
  2814	
  2815	    # Install handlers only on the main thread — tests call this inline from
  2816	    # worker threads and signal() would raise there.
  2817	    if threading.current_thread() is threading.main_thread():
  2818	        for sig_name in ("SIGINT", "SIGTERM"):
  2819	            sig = getattr(signal, sig_name, None)
  2820	            if sig is not None:
  2821	                with contextlib.suppress(ValueError, OSError):
  2822	                    signal.signal(sig, _handle)
  2823	
  2824	    while not stop_event.is_set():
  2825	        try:
  2826	            # Re-resolved every tick (config load is mtime-cached) so operator
  2827	            # edits apply without a restart.
  2828	            max_in_progress = resolve_max_in_progress(configured_max_in_progress())
  2829	            with contextlib.closing(_kbc.connect()) as conn:
  2830	                res = dispatch_once(
  2831	                    conn,
  2832	                    max_spawn=max_spawn,
  2833	                    max_in_progress=max_in_progress,
  2834	                    failure_limit=failure_limit,
  2835	                )
  2836	            if on_tick is not None:
  2837	                with contextlib.suppress(Exception):
  2838	                    on_tick(res)
  2839	        except Exception:
  2840	            # Don't let any single tick kill the daemon.
  2841	            import traceback
  2842	            traceback.print_exc()
  2843	        stop_event.wait(timeout=interval)
