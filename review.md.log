   194	    def is_corrupt_board_db_error(self, exc: Exception) -> bool:
   195	        if isinstance(exc, _kbc().KanbanDbCorruptError):
   196	            return True
   197	        return isinstance(exc, sqlite3.DatabaseError) and any(m in str(exc).lower() for m in _CORRUPT_DB_MARKERS)
