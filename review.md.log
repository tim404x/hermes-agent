    21	def _run_in_fresh_context(func: Callable[..., Any], /, *args: Any) -> Any:
    22	    """Run *func* in an empty ``Context`` so request-local ContextVars stay behind.
    23	
    24	    ``asyncio.to_thread`` copies the caller's context; a lingering
    25	    ``delegate_task`` child marker would make ``write_txn`` false-trip for
    26	    these process-owned writers. An empty Context keeps the DB guard intact
    27	    for real children without exempting dispatcher writes.
    28	    """
    29	    return Context().run(func, *args)
