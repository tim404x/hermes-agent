   199	    def _quarantine_lifted(self, slug: str, fingerprint: tuple) -> bool:
   200	        """Return False while *slug* stays quarantined; lift (and log) otherwise."""
   201	        disabled_entry = self.disabled_corrupt_boards.get(slug)
   202	        if disabled_entry is None:
   203	            return True
   204	        disabled_fingerprint, disabled_at = disabled_entry
   205	        age = time.monotonic() - disabled_at
   206	        if disabled_fingerprint == fingerprint and age < self.CORRUPT_BOARD_RETRY_AFTER_SECONDS:
   207	            return False
   208	        if disabled_fingerprint == fingerprint:
   209	            logger.info("kanban dispatcher: board %s database fingerprint unchanged "
   210	                        "after %.0fs quarantine; retrying dispatch", slug, age)
   211	        else:
   212	            logger.info("kanban dispatcher: board %s database changed; retrying dispatch", slug)
   213	        self.disabled_corrupt_boards.pop(slug, None)
   214	        return True
