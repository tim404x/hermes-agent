   124	def _acquire_singleton_lock(lock_path) -> tuple[Optional[object], str]:
   125	    """Take the exclusive, non-blocking advisory lock for the sole dispatcher.
   126	
   127	    Only one gateway machine-wide may run the embedded dispatcher: concurrent
   128	    dispatchers double reclaim frequency and claim events, and with
   129	    ``wal_autocheckpoint=0`` concurrent manual checkpoints can corrupt index
   130	    pages. ``dispatch_in_gateway`` is the primary control; this is the backstop.
   131	
   132	    Returns ``(handle, "held")`` (release via :func:`_release_singleton_lock`),
   133	    ``(None, "contended")`` when another process holds it (caller must NOT
   134	    dispatch), or ``(None, "unavailable")`` when locking cannot be performed
   135	    (caller falls back to config control).
   136	    """
   137	    try:
   138	        from gateway.status import _try_acquire_file_lock  # deferred; same package
   139	    except ImportError:
   140	        return None, "unavailable"
   141	    try:
   142	        Path(lock_path).parent.mkdir(parents=True, exist_ok=True)
   143	        handle = open(str(lock_path), "a+", encoding="utf-8")  # windows-footgun: ok (append-mode lock handle, write not read)
   144	    except OSError:
   145	        return None, "unavailable"
   146	    if not _try_acquire_file_lock(handle):
   147	        handle.close()
   148	        return None, "contended"
   149	    return handle, "held"
   150	
   151	
   152	def _release_singleton_lock(handle) -> None:
