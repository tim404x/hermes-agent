   150	    def refresh_settings(self) -> None:
   151	        from hermes_cli.config import load_config_readonly
   152	        from hermes_cli.config_backend import ConfigBackendUnavailable
   153	        from hermes_cli.config_read_errors import FailedConfigRead
   154	
   155	        try:
   156	            cfg = load_config_readonly()
   157	            if isinstance(cfg, FailedConfigRead):
   158	                logger.debug("kanban dispatcher: config read failed (%s); keeping previous settings",
   159	                             cfg.read_error)
   160	                return
   161	            kanban = cfg.get("kanban")
   162	            if not isinstance(kanban, dict) or kanban == self._applied_kanban:
   163	                return
