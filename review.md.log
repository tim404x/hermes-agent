   180	    def board_db_fingerprint(self, slug: str) -> tuple[str, int | None, int | None]:
   181	        from hermes_cli import kanban_db as _kb
   182	        with _kb.pin_first_board_resolution():
   183	            path = self.kb.kanban_db_path(slug)
   184	        try:
   185	            resolved = str(path.expanduser().resolve())
   186	        except Exception:
   187	            resolved = str(path)
   188	        try:
   189	            stat = path.stat()
   190	        except OSError:
   191	            return (resolved, None, None)
   192	        return (resolved, stat.st_mtime_ns, stat.st_size)
