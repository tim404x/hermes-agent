    59	    """Parse an optional cap; always warn about invalid values."""
    60	    raw = kanban_cfg.get(key)
    61	    if raw is None:
    62	        return None
    63	    value = _positive_int_value(kanban_cfg, key)
    64	    if value is None:
    65	        try:
    66	            int(raw)
    67	        except (TypeError, ValueError):
    68	            logger.warning("kanban dispatcher: invalid kanban.%s=%r; ignoring", key, raw)
    69	        else:
    70	            logger.warning("kanban dispatcher: kanban.%s=%r is below 1; ignoring", key, raw)
    71	        return None
    72	    if log:
