    49	def _positive_int_value(kanban_cfg: dict, key: str) -> Optional[int]:
    50	    """Return a positive cap or None, without logging on each tick."""
    51	    try:
    52	        value = int(kanban_cfg.get(key))
    53	    except (TypeError, ValueError):
