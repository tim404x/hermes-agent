   154	    if handle is None:
   155	        return
   156	    with contextlib.suppress(Exception):
   157	        from gateway.status import _release_file_lock
   158	
   159	        _release_file_lock(handle)
   160	    with contextlib.suppress(Exception):
   161	        handle.close()

