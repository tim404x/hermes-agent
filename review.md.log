   170	        for setting in fields(settings):
   171	            previous, value = getattr(self.settings, setting.name), getattr(settings, setting.name)
   172	            if value != previous:
   173	                logger.info(
   174	                    "kanban dispatcher: %s changed %s -> %s (config edit applied live)", setting.name,
   175	                    "unset" if previous is None else previous, "unset" if value is None else value,
   176	                )
   177	        self.settings = settings
