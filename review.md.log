  1817	# Memory-aware dispatch guard: an uncapped board once OOM'd a 1 GiB host. Two
  1818	# safeguards — a memory-DERIVED default cap when none is configured
  1819	# (``resolve_max_in_progress``) and a live memory-PRESSURE guard inside the
  1820	# tick (``_memory_pressure_level``) because a static cap can't see other
  1821	# tenants. Both fail open: non-Linux / read error → no cap / "unknown".
  1822	
  1823	# Assumed per-worker footprint for the derived cap; deliberately conservative
  1824	# so the cap errs toward fewer workers on small VMs.
  1825	MEMORY_GUARD_MB_PER_WORKER = 512
  1826	
  1827	# Derived default bounds: never below 2 (smallest VM must still progress),
  1828	# never above 8 (more fan-out must be explicit in config).
