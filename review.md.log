  1856	    if isinstance(total_kib, bool) or not isinstance(total_kib, int) or total_kib <= 0:
  1857	        return None
  1858	    workers = (total_kib // 1024) // MEMORY_GUARD_MB_PER_WORKER
  1859	    return max(DERIVED_MAX_IN_PROGRESS_FLOOR, min(workers, DERIVED_MAX_IN_PROGRESS_CEILING))
