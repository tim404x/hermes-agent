   289	    def auto_decompose_tick(self, auto_decompose_per_tick: int) -> int:
   290	        """Auto-decompose up to N triage tasks across all boards into ready workgraphs.
   291	
   292	        Runs before dispatch fans out; the per-tick cap keeps a bulk triage
   293	        load from burst-spending the aux LLM. Returns the number decomposed.
   294	        """
   295	        try:
   296	            from hermes_cli import kanban_decompose as _decomp
   297	            from hermes_cli.kanban_db import scoped_current_board
   298	        except Exception as exc:  # pragma: no cover
   299	            logger.warning("kanban auto-decompose: import failed (%s); skipping", exc)
   300	            return 0
   301	        attempted = 0
   302	        successes = 0
   303	        from hermes_cli import kanban_db as _kb
   304	        with _default_profile_secret_scope(), _kb.pin_first_board_resolution():
   305	            for slug in self._board_slugs():
   306	                if attempted >= auto_decompose_per_tick:
   307	                    break
