   165	            settings = _resolve_dispatcher_settings(snapshot, self.kb, log=False)
   166	        except (Exception, ConfigBackendUnavailable):  # the latter is a SystemExit on purpose
   167	            logger.debug("kanban dispatcher: could not refresh settings; keeping previous values", exc_info=True)
   168	            return
