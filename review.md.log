    77	def _resolve_auto_decompose_settings(load_config: Callable[[], Any]) -> tuple[bool, int]:
    78	    """Live (enabled, per_tick) auto-decompose settings, re-read every dispatcher tick.
    79	
    80	    Fails safe: a config read error returns ``(False, 3)`` rather than
    81	    re-enabling a feature the user turned off. ``per_tick`` is clamped to ``>= 1``.
    82	
    83	    Read fresh from config on every dispatcher tick (#49638) so that flipping ``kanban.auto_decompose:
    84	    false`` to STOP runaway fan-out takes effect on the next tick instead of requiring a gateway restart.
    85	    Auto-decompose is a safety toggle — a user who sees it create and launch tasks they didn't intend
    86	    reaches for this flag to halt it, and a stale boot-captured value silently ignoring that change is the
    87	    bug reported in #49638.
    88	    """
    89	    try:
    90	        cfg = load_config()
    91	    except Exception:
    92	        return False, 3
    93	    kcfg = cfg.get("kanban", {}) if isinstance(cfg, dict) else {}
    94	    try:
    95	        per_tick = int(kcfg.get("auto_decompose_per_tick", 3) or 3)
    96	    except (TypeError, ValueError):
    97	        per_tick = 3
    98	    return bool(kcfg.get("auto_decompose", True)), max(per_tick, 1)
