   343	@contextlib.contextmanager
   344	def _default_profile_secret_scope():
   345	    """Install the gateway launch profile's secret scope while multiplexing is on.
   346	
   347	    The tick runs via ``_to_thread_process_service`` in a fresh context, so no
   348	    per-turn scope exists and ``get_secret`` fails closed. The decomposer's aux
   349	    LLM reads ``auxiliary.*`` from ``get_hermes_home()``, so its credentials come
   350	    from that same home. No-op for single-profile gateways.
   351	    """
   352	    from agent.secret_scope import is_multiplex_active, reset_secret_scope, set_secret_scope
   353	    from hermes_constants import get_hermes_home
   354	    from tui_gateway.launch_profile_policy import owner_secret_scope
   355	
   356	    if not is_multiplex_active():
   357	        yield
   358	        return
   359	    token = set_secret_scope(owner_secret_scope(Path(get_hermes_home())), profile_home=str(get_hermes_home()))
   360	    try:
   361	        yield
   362	    finally:
   363	        reset_secret_scope(token)
